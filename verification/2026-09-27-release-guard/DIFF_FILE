+    settings.write_text('auto_mic_switch=0\nmic_restore_pending=0\n', encoding='utf-8')
+    gate = folder / 'gate'
+    gate.mkdir()
+    address = 'AABBCCDDEEFF'
+    render = '{0.0.0.00000000}.{11111111-1111-1111-1111-111111111111}'
+    mic = ['original'] * 3
+    rows = []
+    expected = [(0, 'baseline', 'inspect')]
