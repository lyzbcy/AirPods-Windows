+            row['ksRequests'] = [1]
+            (gate / filename).write_text('INFO bluetooth worker connect address=AABBCCDDEEFF requested=1 ksTrace=x\n', encoding='utf-8')
+        else:
+            (gate / filename).write_text('RESULT ok\n', encoding='utf-8')
